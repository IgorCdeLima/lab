# Modelo de configuração. Copie para .env e ajuste; o .env fica fora do Git.
# Sem .env, o docker-compose.yml usa valores padrão APENAS para desenvolvimento local.

# Banco de dados (usadas pelo serviço db e pela aplicação)
POSTGRES_USER=lab
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=lab

# Endereço do banco visto pela aplicação (dentro do Compose, o host é "db")
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Porta publicada da aplicação na máquina local
APP_PORT=8000
