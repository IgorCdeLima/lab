{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(*--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git -c *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(*--no-verify*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n*)",
      "PowerShell(git -c *)",
      "PowerShell(Remove-Item * -Recurse*)"
    ],
    "ask": [
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.githooks/**)",
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git config *)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(git config *)",
      "PowerShell(Remove-Item *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "py -3 D:/01_IA/ferramentas/hooks/registrar_evento.py", "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "py -3 D:/01_IA/ferramentas/hooks/registrar_evento.py", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell", "hooks": [ { "type": "command", "command": "py -3 D:/01_IA/ferramentas/hooks/registrar_evento.py", "timeout": 10 } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "py -3 D:/01_IA/ferramentas/hooks/registrar_evento.py", "timeout": 10 } ] }
    ],
    "PermissionDenied": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "py -3 D:/01_IA/ferramentas/hooks/registrar_evento.py", "timeout": 10 } ] }
    ],
    "StopFailure": [
      { "hooks": [ { "type": "command", "command": "py -3 D:/01_IA/ferramentas/hooks/registrar_evento.py", "timeout": 10 } ] }
    ]
  }
}
